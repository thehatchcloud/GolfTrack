# Database
DATABASE_URL="file:./dev.db"

# Auth.js core (https://authjs.dev)
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public origin of the app. Required in production; optional in dev.
# AUTH_URL="https://example.com"
# Set when running behind a reverse proxy that terminates TLS (e.g. exe.dev).
AUTH_TRUST_HOST="true"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Microsoft Entra ID (https://entra.microsoft.com → App registrations)
# Redirect URI (web): {AUTH_URL}/api/auth/callback/microsoft-entra-id
# Supported account types: "Accounts in any organizational directory and personal Microsoft accounts" → issuer = common
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# Defaults to https://login.microsoftonline.com/common/v2.0 when unset.
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# Comma-separated list of email addresses to grant admin role on sign-in.
ADMIN_EMAILS=""

# --- Django rewrite (#85). The Next.js vars above remain until cutover. ---
DJANGO_SECRET_KEY=""
DJANGO_DEBUG="true"
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1"
# DJANGO_CSRF_TRUSTED_ORIGINS="https://golftrack.exe.xyz:3000"
