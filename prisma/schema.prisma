generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts Account[]
  sessions Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @map("refresh_token")
  access_token      String? @map("access_token")
  expires_at        Int?    @map("expires_at")
  token_type        String? @map("token_type")
  scope             String?
  id_token          String? @map("id_token")
  session_state     String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum UserRole {
  USER
  ADMIN
}

model Course {
  id        Int          @id @default(autoincrement())
  name      String
  holeCount Int          @map("hole_count")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  holes  CourseHole[]
  rounds Round[]

  @@map("courses")
}

model CourseHole {
  id         Int    @id @default(autoincrement())
  courseId   Int    @map("course_id")
  holeNumber Int    @map("hole_number")
  par        Int

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, holeNumber])
  @@map("course_holes")
}

model Round {
  id               Int         @id @default(autoincrement())
  courseId         Int         @map("course_id")
  status           RoundStatus
  playMode         String      @default("full") @map("play_mode")
  startedAt        DateTime    @default(now()) @map("started_at")
  finishedAt       DateTime?   @map("finished_at")
  note             String?
  currentHole      Int         @default(1) @map("current_hole")
  totalStrokes     Int?        @map("total_strokes")
  totalPar         Int?        @map("total_par")
  relativeToPar    Int?        @map("relative_to_par")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  holes  RoundHole[]

  @@index([status])
  @@index([courseId])
  @@map("rounds")
}

model RoundHole {
  id         Int      @id @default(autoincrement())
  roundId    Int      @map("round_id")
  holeNumber Int      @map("hole_number")
  par        Int
  strokes    Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
  shots Shot[]

  @@unique([roundId, holeNumber])
  @@map("round_holes")
}

model Shot {
  id          Int      @id @default(autoincrement())
  roundHoleId Int      @map("round_hole_id")
  shotNumber  Int      @map("shot_number")
  club        String
  createdAt   DateTime @default(now()) @map("created_at")

  roundHole RoundHole @relation(fields: [roundHoleId], references: [id], onDelete: Cascade)

  @@unique([roundHoleId, shotNumber])
  @@map("shots")
}

enum RoundStatus {
  in_progress
  completed
}
