==> litestream.yml
# Generated by golftrack-pb from the backup setting (sftp://golftrack@backup.example.com:22/srv/golftrack).
# Rewritten every time Litestream starts; edits here are lost.
dbs:
  - path: "/data/data.db"
    replica:
      type: "sftp"
      host: "backup.example.com:22"
      user: "golftrack"
      key-path: "/data/backup/run/sftp_key"
      path: "/srv/golftrack/data"
  - path: "/data/auxiliary.db"
    replica:
      type: "sftp"
      host: "backup.example.com:22"
      user: "golftrack"
      key-path: "/data/backup/run/sftp_key"
      path: "/srv/golftrack/auxiliary"
socket:
  enabled: true
  path: "/data/backup/run/litestream.sock"
  permissions: 384
==> sftp_key
-----BEGIN OPENSSH PRIVATE KEY-----
KEY
-----END OPENSSH PRIVATE KEY-----
