==> litestream.yml
# Generated by golftrack-pb from the backup setting (s3://b/pocketbase at https://minio.local:9000).
# Rewritten every time Litestream starts; edits here are lost.
dbs:
  - path: "/data/data.db"
    replica:
      type: "s3"
      bucket: "b"
      path: "pocketbase/data"
      region: "us-east-1"
      endpoint: "https://minio.local:9000"
      force-path-style: true
      skip-verify: true
      access-key-id: "AK"
      secret-access-key: "SK"
  - path: "/data/auxiliary.db"
    replica:
      type: "s3"
      bucket: "b"
      path: "pocketbase/auxiliary"
      region: "us-east-1"
      endpoint: "https://minio.local:9000"
      force-path-style: true
      skip-verify: true
      access-key-id: "AK"
      secret-access-key: "SK"
retention:
  enabled: false
socket:
  enabled: true
  path: "/data/backup/run/litestream.sock"
  permissions: 384
