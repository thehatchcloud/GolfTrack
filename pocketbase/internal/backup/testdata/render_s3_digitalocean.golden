==> litestream.yml
# Generated by golftrack-pb from the backup setting (s3://golftrack-backup/pocketbase at https://nyc3.digitaloceanspaces.com).
# Rewritten every time Litestream starts; edits here are lost.
dbs:
  - path: "/data/data.db"
    replica:
      type: "s3"
      bucket: "golftrack-backup"
      path: "pocketbase/data"
      region: "nyc3"
      endpoint: "https://nyc3.digitaloceanspaces.com"
      access-key-id: "AK"
      secret-access-key: "SK"
  - path: "/data/auxiliary.db"
    replica:
      type: "s3"
      bucket: "golftrack-backup"
      path: "pocketbase/auxiliary"
      region: "nyc3"
      endpoint: "https://nyc3.digitaloceanspaces.com"
      access-key-id: "AK"
      secret-access-key: "SK"
socket:
  enabled: true
  path: "/data/backup/run/litestream.sock"
  permissions: 384
