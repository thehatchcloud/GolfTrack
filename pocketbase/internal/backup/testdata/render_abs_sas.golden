==> litestream.yml
# Generated by golftrack-pb from the backup setting (abs://acct/backups/pocketbase).
# Rewritten every time Litestream starts; edits here are lost.
dbs:
  - path: "/data/data.db"
    replica:
      type: "abs"
      account-name: "acct"
      sas-token: "sv=1\u0026sig=x"
      bucket: "backups"
      path: "pocketbase/data"
  - path: "/data/auxiliary.db"
    replica:
      type: "abs"
      account-name: "acct"
      sas-token: "sv=1\u0026sig=x"
      bucket: "backups"
      path: "pocketbase/auxiliary"
socket:
  enabled: true
  path: "/data/backup/run/litestream.sock"
  permissions: 384
