==> gcs.json
{"type":"service_account","client_email":"litestream@proj.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\nabc\n-----END PRIVATE KEY-----\n"}
==> litestream.yml
# Generated by golftrack-pb from the backup setting (gs://golftrack/prod).
# Rewritten every time Litestream starts; edits here are lost.
dbs:
  - path: "/data/data.db"
    replica:
      type: "gs"
      bucket: "golftrack"
      path: "prod/data"
  - path: "/data/auxiliary.db"
    replica:
      type: "gs"
      bucket: "golftrack"
      path: "prod/auxiliary"
socket:
  enabled: true
  path: "/data/backup/run/litestream.sock"
  permissions: 384
==> env GOOGLE_APPLICATION_CREDENTIALS=/data/backup/run/gcs.json
