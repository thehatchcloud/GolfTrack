==> litestream.yml
# Generated by golftrack-pb from the backup setting (sftp://golftrack@backup.example.com:2222/srv/golftrack).
# Rewritten every time Litestream starts; edits here are lost.
dbs:
  - path: "/data/data.db"
    replica:
      type: "sftp"
      host: "backup.example.com:2222"
      user: "golftrack"
      password: "pa$$\"word"
      host-key: "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAITEST"
      path: "/srv/golftrack/data"
  - path: "/data/auxiliary.db"
    replica:
      type: "sftp"
      host: "backup.example.com:2222"
      user: "golftrack"
      password: "pa$$\"word"
      host-key: "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAITEST"
      path: "/srv/golftrack/auxiliary"
socket:
  enabled: true
  path: "/data/backup/run/litestream.sock"
  permissions: 384
