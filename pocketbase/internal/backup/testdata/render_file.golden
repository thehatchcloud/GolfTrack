==> litestream.yml
# Generated by golftrack-pb from the backup setting (local directory /backup).
# Rewritten every time Litestream starts; edits here are lost.
dbs:
  - path: "/data/data.db"
    replica:
      type: "file"
      path: "/backup/data"
  - path: "/data/auxiliary.db"
    replica:
      type: "file"
      path: "/backup/auxiliary"
socket:
  enabled: true
  path: "/data/backup/run/litestream.sock"
  permissions: 384
